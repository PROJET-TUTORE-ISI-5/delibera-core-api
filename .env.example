# Modèle du fichier d'environnement de production, lu par deploy/compose.prod.yaml.
# Sur l'EC2, Terraform le crée dans /etc/delibera-api/delibera-api.env avec des secrets générés
# sur place : ce modèle sert à le comprendre, ou à lancer l'image de production ailleurs.
# Ne jamais versionner un fichier rempli.
DELIBERA_DB_USER=delibera
DELIBERA_DB_PASSWORD=
# Au moins 32 caractères aléatoires, par exemple : openssl rand -base64 48
DELIBERA_JWT_SECRET=
DELIBERA_CORS_ORIGINES=https://delibera.exemple.cm
# Mémoire de la JVM (sans guillemets) : 384 Mo sur un t3.micro, 768 Mo sur un t3.small
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC
# Serveur de courriels (module M10)
# DELIBERA_SMTP_HOST=smtp.exemple.org
# DELIBERA_SMTP_PORT=587
# DELIBERA_SMTP_USER=
# DELIBERA_SMTP_PASSWORD=
