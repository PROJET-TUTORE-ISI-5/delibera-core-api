# Variables d'environnement du profil prod. Copier en .env (jamais versionné) et remplir.
SPRING_PROFILES_ACTIVE=prod
DELIBERA_DB_URL=jdbc:postgresql://postgres:5432/delibera
DELIBERA_DB_USER=delibera
DELIBERA_DB_PASSWORD=
# Au moins 32 caractères aléatoires, par exemple : openssl rand -base64 48
DELIBERA_JWT_SECRET=
DELIBERA_CORS_ORIGINES=https://delibera.exemple.cm
DELIBERA_SMTP_HOST=
DELIBERA_SMTP_PORT=587
DELIBERA_SMTP_USER=
DELIBERA_SMTP_PASSWORD=
